# Public hostname of the Fly app (no scheme).
# Prefer FEEDGEN_HOSTNAME — plain HOSTNAME collides with the OS/shell variable.
FEEDGEN_HOSTNAME=capital-region-feed.fly.dev

# did:web for this feedgen service (defaults to did:web:$FEEDGEN_HOSTNAME)
SERVICE_DID=did:web:capital-region-feed.fly.dev

# Feed record URI after publish / cutover
FEED_URI=at://did:plc:xndplob7sicvv6balxdzh3jk/app.bsky.feed.generator/aaagkkw3yejuk

# Bluesky credentials for publish_feed.py only (use an app password)
HANDLE=chriscarrollsmith.bsky.social
PASSWORD=

# Keep the existing SkyFeed rkey so subscribers keep the same URL
RECORD_NAME=aaagkkw3yejuk
DISPLAY_NAME=Albany, NY
DESCRIPTION=Posts from and about New York's Capital Region (Albany, Troy, Schenectady, and nearby).
AVATAR_PATH=

# Runtime knobs
IGNORE_REPLY_POSTS=true
IGNORE_ARCHIVED_POSTS=true
POST_RETENTION_DAYS=7
# Soft author priors (B-012): unlock bare ambiguous places after N strong matches
SOFT_PRIOR_MIN_STRONG=3
SOFT_PRIOR_WINDOW_DAYS=30
DATABASE_PATH=/data/feed_database.db
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
PORT=8080
LOG_LEVEL=INFO

# Feed ranking among indexed matches: indexed | created | engagement
RANKING_MODE=indexed
# Comma-separated substrings; matching posts are not indexed (empty = off)
MUTED_KEYWORDS=

# Offline LLM label bootstrap only (scripts/llm_label_judge.py). Not used by the feed server.
DEEPSEEK_API_KEY=
